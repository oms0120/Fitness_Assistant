# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local config
.claude/

# sqlite
prisma/*.db
prisma/*.db-journal

# rag service (venv + 语料/向量库本地生成，不提交)
rag-service/.venv/
rag-service/data/
# cross-encoder 权重（bge-reranker-base，279MB 的量化 ONNX）。
# 与 data/ 同理：本地按需下载，不进仓库。缺了不影响服务启动，只是 rerank 自动降级。
rag-service/models/
# 任意深度：eval/ 下的脚本同样会生成 __pycache__
__pycache__/

# eval 报告（本地生成，用于同一台机器上跨版本对比）
# 需要长期留存、要给人看的结论写进 eval/baseline-report.md 这类 markdown，那些是提交的；
# 这里的 <日期>-<prompt 版本>-*.json 是逐条的原始数据，量大且可重跑，不进仓库
/eval-reports/
