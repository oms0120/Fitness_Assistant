# 环境变量样例。用法：cp .env.example .env
#
# **真实密钥只放在平台的环境变量面板里，不写进仓库。** 本文件里出现的一律是
# 占位值或空值。`.env` 本身被 .gitignore 忽略（`.env*` + `!.env.example`），
# 进版本库的只有本文件 —— 别把真 key 粘进来。
#
# 每一项都写了「不设时的默认值」。**可选项目默认全部注释掉**：取消注释 = 改行为，
# 先读清楚那一行再动。要跑起来最少只需要上面两行（DATABASE_URL / AUTH_SECRET）。

# ── 必填 ────────────────────────────────────────────────────────────────

# Prisma 的 SQLite 路径。相对路径按 schema.prisma 所在目录（prisma/）解析，
# 所以 file:./dev.db 落在 prisma/dev.db，不是仓库根目录。
DATABASE_URL="file:./dev.db"

# Auth.js 的会话签名密钥。**必须换成随机值**，用示例里这串等于没有会话安全。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意本仓没装 @auth/cli，`npx auth secret` 用不了。
AUTH_SECRET="replace-with-a-random-secret"

# ── AI 后端 ─────────────────────────────────────────────────────────────
# 分派逻辑见 src/lib/ai/llm.ts：不设 AI_PROVIDER 时按配置了哪个 key 自动探测
# （DeepSeek 优先）；显式指定但缺对应 key 会**降级回 rule**，不是硬报错。
# rule 模式不花钱、不需要任何 key，评测和本地开发用它。

# 可选：deepseek / claude / rule。留空 = 自动探测。
# AI_PROVIDER=deepseek

# DeepSeek。配了 key 即启用。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时（毫秒）。默认 60000。
# DEEPSEEK_TIMEOUT_MS=60000
# 失败重试次数。默认 2。
# DEEPSEEK_RETRIES=2

# Claude。配了 key 且 AI_PROVIDER=claude 即启用。
# ANTHROPIC_API_KEY=
# 默认 SDK 自带的 https://api.anthropic.com。一般只在校验脚本里指向本地 mock。
# ANTHROPIC_BASE_URL=
# 单次请求超时（毫秒）。默认 300000 —— SDK 自己的默认是 10 分钟，
# 对一次对话请求等于没上限，所以代码里显式封了顶。见 claudeProvider.ts。
# ANTHROPIC_TIMEOUT_MS=300000
# 默认 2。SDK 自带指数退避 + jitter，代码没有再套一层（否则尝试次数相乘）。
# ANTHROPIC_MAX_RETRIES=2

# ── 检索（RAG）─────────────────────────────────────────────────────────

# Python 检索服务地址。默认 http://127.0.0.1:8000；容器编排里指向 rag:8000。
# RAG_SERVICE_URL=http://127.0.0.1:8000
# 检索超时（毫秒）。默认 15000。hybrid 模式中位只要 ~60ms，余量是留给
# hybrid+rerank20（中位 ~4.9s）和冷启动加载模型的。池深如果再往上加，这里要跟着调。
# RAG_TIMEOUT_MS=15000

# 下面这几项由 rag-service 自己读（不是 Next 应用）。README 的 RAG 一节有背景。
# 基础模式 dense / bm25 / hybrid，默认 hybrid（量出来的，见 eval/run_retrieval_eval.py）；
# 重排写成池深后缀，如 hybrid+rerank20。bm25 只用来做归因，线上不用。
# RAG_RETRIEVAL_MODE=hybrid

# ── Ollama（rag-service 读）─────────────────────────────────────────────

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# embedding 模型名。默认 bge-m3。
# OLLAMA_EMBED_MODEL=bge-m3
# 模型驻留时长。默认 -1（永不卸载）—— 这是空闲后第一次问答不再丢出处的那个修复，
# 见 rag-service/embedding.py。设 30m 这类时长可以省内存，代价是冷加载要等。
# OLLAMA_KEEP_ALIVE=-1

# ── 预算与限流 ──────────────────────────────────────────────────────────
# 见 src/lib/ai/usage.ts 与 src/lib/ai/rateLimit.ts。

# 每用户每日模型调用次数。两处都写 0 表示**不限制**（不是「全拦」）。
# AI_DAILY_CALL_LIMIT=50
# 全站每日 token 和（prompt + completion）。
# AI_DAILY_TOKEN_LIMIT=2000000
# 预算重置用的时区偏移（分钟）。默认 0（UTC）—— 额度重置不需要对齐用户的
# 一天，UTC 是唯一在开发机和生产上一致的选择。负数合法（-720 = UTC-12）。
# AI_BUDGET_TZ_OFFSET_MIN=0

# 每用户限流，默认 10 次/分，写 0 表示不限制。
# 注意桶存在**进程内存**里：单实例部署够用，多实例下每实例各算各的，
# 实际额度是 N 倍，届时要换成 Redis。
# AI_RATE_LIMIT_PER_MIN=10

# ── 日志 ────────────────────────────────────────────────────────────────

# 见 src/lib/logger.ts。生产输出单行 JSON 到 stdout；开发（NODE_ENV 正好是
# development）自动换成 pino-pretty 彩色输出。默认 info，低于该级别的不写出。
# 注意 scripts/*.ts 里这行不生效，脚本一律按 info 走。
# LOG_LEVEL=info

# ── 重排（rag-service，一般不用动）──────────────────────────────────────
# 只有跑 RAG_RETRIEVAL_MODE=hybrid+rerank20 才加载。默认值是 CPU 上调过的，
# 改之前先看 rag-service/rerank.py 里的说明。模型文件从 rag-service/models/ 加载，
# 目录不存在会软降级回 base 模式（不报错，只是不重排）。
# RAG_RERANK_BATCH=16
# RAG_RERANK_THREADS=4
# RAG_RERANK_MAX_LENGTH=512

# ── 只在容器 / 反向代理后面需要 ─────────────────────────────────────────
# 这三项由 docker-compose.yml 直接给，本地 `npm run dev` 不用设。写在 .env 里
# 反而可能盖掉编排里的值，所以默认注释。
#
# AUTH_TRUST_HOST=true   # 容器里 NODE_ENV=production，不设它每个 auth 请求 500 UntrustedHost
# AUTH_URL=http://localhost:3000
# HOSTNAME=0.0.0.0       # Docker 注入的 HOSTNAME 会盖掉镜像 ENV，server.js 读的就是它

# 评测 / 校验脚本自己的一次性开关（EVAL_SMOKE、VERIFY_BASE_URL、RATE_LIMIT_EXPECT 等）
# 不列在这里，见 scripts/ 与 rag-service/eval/ 下各自的用法说明。
