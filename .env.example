DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-secret"

# AI 每日预算，两行都可选。不设就用代码里的默认值（见 src/lib/ai/usage.ts）。
# 两处都写 0 表示**不限制**（不是「全拦」）。
# AI_DAILY_CALL_LIMIT=50          # 每用户每日模型调用次数
# AI_DAILY_TOKEN_LIMIT=2000000    # 全站每日 token 和（prompt + completion）

# 每用户限流，见 src/lib/ai/rateLimit.ts。默认 10 次/分，写 0 表示不限制。
# 注意桶存在**进程内存**里：单实例部署够用，多实例下每实例各算各的，
# 实际额度是 N 倍，届时要换成 Redis。
# AI_RATE_LIMIT_PER_MIN=10
